sample_name = "lask-example-02"

test() = $[#golang:latest] go test -v ./...

build(
  --image: String = sample_name,
  --version: String = "latest"
) = $ docker build -t #{image}:#{version} .

start(
  --name: String = sample_name,
  --image: String = sample_name,
  --version: String = "latest"
) = $ docker run -d --rm -p 8000:8000 --name #{name} #{image}:#{version}

stop(--name: String = sample_name) = $ docker stop #{name}

status(--name: String = sample_name) = $ docker ps -a --filter name="#{name}"

clean(
  --image: String = sample_name,
  --version: String = "latest"
) = $ docker rmi -f #{image}:#{version}
