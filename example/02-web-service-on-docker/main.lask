sample-name = "lask-example-02"

test = $[#golang:latest] go test -v ./...;

build(
  -image = sample-name,
  -version = "latest"
) = $ docker build -t #{ image }:#{ version } .;

start(
  -name = sample-name,
  -image = sample-name,
  -version = "latest"
) = $ docker run -d --rm \\
  -p 8000:8000 \\
  --name #{ name } \\
  #{ image }:#{ version };

stop(
  -name = sample-name,
  -image = sample-name,
  -version = "latest"
) = $ docker stop #{ name };

status(-name = sample-name) = $ docker ps -a --filter name="#{ name }";

clean(
  -image = sample-name,
  -version = "latest"
) = $ docker rmi -f #{ image }:#{ version };
