import * as tools from "tools"

command { "python", "pip" } on python
command { "node", "npm", "npx" } on node
command { "aws" } on aws
command { "terraform" } on terraform
command { "curl" } on tools.unix()

aws_access_key_id = mark_secret(get_env("AWS_ACCESS_KEY_ID"))
aws_secret_access_key = mark_secret(get_env("AWS_SECRET_ACCESS_KEY"))
aws_region = get_env("AWS_DEFAULT_REGION")

python = tools.python(tag = "3.12.14-alpine3.24")
node = tools.node(tag = "20.20.2-alpine3.23")
aws = tools.aws(
  tag = "2.36.41",
  access_key_id = aws_access_key_id,
  secret_access_key = aws_secret_access_key,
  region = aws_region
)
terraform = tools.terraform(
  tag = "1.16.2",
  extra_env = {
    "TF_VAR_aws_access_key_id": aws_access_key_id,
    "TF_VAR_aws_secret_access_key": aws_secret_access_key,
    "TF_VAR_aws_region": aws_region
  }
)
playwright = tools.playwright(tag = "v1.62.1-jammy")

internal as_string(v: Any): String = cast(v)

// Runs the API's Python unit tests (api/).
test_api() = $ pip install -q --no-cache-dir -r api/requirements.txt && python -m unittest discover -s api -p "test_*.py"

// Runs the frontend's unit tests (web/).
test_web() = $ cd web && npm ci --no-audit --no-fund && npm test

// Runs the fast, offline tests. test_e2e is kept separate since it needs
// a deployed stack and a signed-in user.
test() = do {
  test_api()
  test_web()
}

// Browser end-to-end test against the deployed site (e2e/): opens the
// site, signs in through the real Cognito Hosted UI, and walks through
// creating, listing, and deleting an order.
//
// The sign-in user must already exist: run `lask run create_user` once
// first, with the same email/password as E2E_EMAIL/E2E_PASSWORD in .env.
test_e2e(
  --email: String = get_env("E2E_EMAIL"),
  --password!!: String = get_env("E2E_PASSWORD")
) = do {
  website = tf_output().website_url

  $[playwright] cd e2e && \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --no-audit --no-fund && \
    E2E_BASE_URL="#{website}" \
    E2E_EMAIL="#{email}" \
    E2E_PASSWORD="#{password}" \
    npx playwright test
}

// Installs the API's Python dependencies into api/vendor so the Lambda
// deployment package (infra/lambda.tf) includes them.
build_lambda_deps() = $ pip install -q --no-cache-dir -r api/requirements.txt --target api/vendor --upgrade

// Builds the React frontend (web/) with the deployed API and Cognito
// settings baked in as environment variables, so the built bundle needs
// no configuration once it is uploaded to S3.
build_web(
  api_url: String,
  cognito_authority: String,
  cognito_client_id: String,
  cognito_domain: String,
  redirect_uri: String
) = $ cd web && npm ci --no-audit --no-fund && \
  VITE_API_URL="#{api_url}" \
  VITE_COGNITO_AUTHORITY="#{cognito_authority}" \
  VITE_COGNITO_CLIENT_ID="#{cognito_client_id}" \
  VITE_COGNITO_DOMAIN="#{cognito_domain}" \
  VITE_REDIRECT_URI="#{redirect_uri}" \
  npm run build

// The handful of infra/ outputs the tasks below actually use.
type InfraOutputs = Record<
  api_url: String,
  frontend_bucket: String,
  cognito_issuer: String,
  user_pool_client_id: String,
  cognito_domain: String,
  website_url: String,
  cloudfront_distribution_id: String,
  user_pool_id: String
>

// Fetches every Terraform output in infra/ with a single `terraform output
// -json` call and returns it as one typed record — cheaper than calling
// terraform_output() (which re-runs that command) once per field, and lets
// callers write tf_output().api_url instead of a name string.
tf_output(): InfraOutputs = do {
  os = terraform_outputs()
  {
    api_url: output_field(os, "api_url"),
    frontend_bucket: output_field(os, "frontend_bucket"),
    cognito_issuer: output_field(os, "cognito_issuer"),
    user_pool_client_id: output_field(os, "user_pool_client_id"),
    cognito_domain: output_field(os, "cognito_domain"),
    website_url: output_field(os, "website_url"),
    cloudfront_distribution_id: output_field(os, "cloudfront_distribution_id"),
    user_pool_id: output_field(os, "user_pool_id")
  }
}

internal terraform_outputs(): Map<Any> = do {
  raw = $ terraform -chdir=infra output -json -no-color
  cast(from_json(raw))
}

internal output_field(os: Map<Any>, name: String): String = do {
  entry: Map<Any> = cast(get(os, name))
  as_string(get(entry, "value"))
}

// Deploys everything: applies the Terraform infra, builds the frontend
// against it, and uploads the result to S3/CloudFront.
//
// aws_region/aws_access_key_id/aws_secret_access_key are ordinary
// Terraform variables that infra/ feeds straight to the AWS provider (see
// infra/providers.tf); the "terraform" command's TF_VAR_* environment
// (above) supplies them, so no -var flag puts a secret on the command line.
deploy() = do {
  build_lambda_deps()
  $ terraform -chdir=infra init -input=false -no-color
  $ terraform -chdir=infra apply -input=false -no-color -auto-approve

  output = tf_output()

  build_web(output.api_url, output.cognito_issuer, output.user_pool_client_id, output.cognito_domain, "#{output.website_url}/")

  $ aws s3 sync web/dist "s3://#{output.frontend_bucket}" --delete

  // Invalidates the cached index.html so the new build is served
  // immediately instead of the previous one.
  $ aws cloudfront create-invalidation --distribution-id "#{output.cloudfront_distribution_id}" --paths /index.html
}

// Creates a Cognito sign-in user with a permanent password (self sign-up
// is disabled, so this is the only way to add one).
create_user(
  email: String,
  password!!: String
) = do {
  pool = tf_output().user_pool_id
  $ aws \
    cognito-idp admin-create-user --user-pool-id "#{pool}" --username "#{email}" \
    --user-attributes Name=email,Value="#{email}" Name=email_verified,Value=true \
    --message-action SUPPRESS
  $ aws \
    cognito-idp admin-set-user-password --user-pool-id "#{pool}" --username "#{email}" \
    --password "#{password}" --permanent
}

// Tears down everything deploy() created.
destroy() = $ terraform -chdir=infra destroy -input=false -no-color -auto-approve

// Reads a Terraform output by name, e.g. api_url or website_url.
//   lask eval --stdout-encode text terraform_output api_url
terraform_output(name: String): String = output_field(terraform_outputs(), name)

type Healthcheck = Record<status: String>

// Calls the deployed API's health route and returns its HTTP status.
healthcheck_api(): Healthcheck = do {
  url = tf_output().api_url
  status = $ curl -s -o /dev/null -w "%{http_code}" "#{url}"
  return { status: status }
}

// Same as healthcheck_api, but for the frontend: it's a static site with
// no JSON body, so the HTTP status code is the health signal instead.
healthcheck_web(): Healthcheck = do {
  url = tf_output().website_url
  status = $ curl -s -o /dev/null -w "%{http_code}" "#{url}"
  return { status: status }
}
