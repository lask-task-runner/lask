// External dependencies
//
// Tasks that are worth sharing live in their own repository and are
// imported by name, not copied. What a dependency is, is declared in
// lask.json; which bytes it is, is pinned in the committed
// lask.lock.json.
//
//   lask deps sync            # the only step that touches the network
//   lask deps why terraform   # why is this here?
//   lask deps diff terraform  # what would a bump change?
//   lask env build && lask eval tool-version

// An import with no "./" is an external dependency, and the name is the
// key from lask.json — not a URL, not a path. Nothing in the source
// says where it came from or which revision it is; that belongs in
// lask.json and lask.lock.json, where it can be reviewed and pinned.
import * as tf from "terraform"

// The named form works the same way, `as` included.
import { version as terraform_version } from "terraform"

// An import reaches a dependency's root main.lask and nothing else:
// `import { x } from "terraform/lib/args.lask"` is a static error
// (E-MODULE-DEEP-IMPORT). A library whose API spans several files
// re-exports it from its own entry module, which is why every
// dependency has exactly one surface.

// The version of terraform the shared module runs.
//
// The environment comes from the dependency's own default — the image
// is pinned over there, and `lask envs` lists it here all the same.
tool_version(): String = terraform_version()
  |> lines
  |> first

// Check formatting, through the namespace import.
//
// @param dir  A directory of .tf files.
fmt_ok(--dir: String = "."): Bool = tf.fmt_check(dir = dir)

// What the dependency contributes to this module.
//
// A dependency is ordinary code: its tasks are called like any other,
// and its types can be named here too.
//
// @return The tool version, and whether this directory is formatted.
status(): Record<version: String, formatted: Bool> = {
  version: tool_version(),
  formatted: fmt_ok()
}

// Nothing here reaches the network. `check`, `run`, `eval` and `envs`
// resolve everything from the fetched tree in .lask/, and a dependency
// that is missing or whose hash does not match the lock is an error
// naming `lask deps sync` — never a silent fetch in the middle of a run.
