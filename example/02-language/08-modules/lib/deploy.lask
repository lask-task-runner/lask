// A second library, this one running commands.
//
// A command declaration is exported unless it is marked `internal`,
// but it governs another module only once that module names the word
// in `import command { ... }` — main.lask does, for "echo". A named or
// a namespace import brings in no command word.
command { "echo" } on #alpine:3.22.2

// @param target   Where to roll out to.
// @param version  What to roll out.
rollout(target: String, --version: String = "latest"): String = do {
  out = $ echo "rolling out #{version} to #{target}"
  trim(out)
}

// A module can expose values, not just functions.
targets: Array<String> = ["staging", "production"]
