// Modules and imports
//
// One file is one module. Inside a project, modules import each other
// by relative path; across projects, they are pinned dependencies —
// example/terraform shows that side of it.
//
//   lask check
//   lask eval page_title "  Release Notes  "
//   lask env build && lask eval ship

// Named import. `as` renames, and a type comes across the same way a
// function does.
import { slugify, titleize as to_title, Slug } from "./lib/text.lask"

// Namespace import: everything the module exports, under one name.
import * as deploy from "./lib/deploy.lask"

// Re-export: `ship_to` becomes a public symbol of *this* module, with
// the parameter list of the original intact — keyword parameters,
// defaults and arity all preserved, unlike `f = m.f`, which would make
// a function value and lose them. It is how a library whose public API
// spans several files publishes all of it from one entry module.
export { rollout as ship_to } from "./lib/deploy.lask"

// Turn free text into a page title.
//
// `internal` is not importable, so `dashes` and `capitalize` inside
// lib/text.lask cannot be reached from here — only what the library
// chose to publish.
//
// @example lask eval page-title "  Release Notes  "
page_title(raw: String): String = do {
  s: Slug = slugify(raw)
  to_title(s)
}

// Every target the deploy library knows about.
//
// Imported values are ordinary values.
//
// @return Every target the deploy library knows about.
known_targets(): Array<String> = deploy.targets

// Roll a version out to every target.
//
// A call into another module is an ordinary call. The command inside
// `rollout` runs in the environment *that* module declared — dispatch
// is resolved where the command is written, so importing a module never
// silently brings its command words here.
//
// @example lask run ship --version 1.4.0
ship(--version: String = "1.4.0"): Array<String> =
  for (t : deploy.targets) { deploy.rollout(t, version = version) }

// The import graph has to be acyclic, and an import of an external
// dependency reaches only that dependency's root main.lask — never a
// file inside it.
