# `lask env build` writes a lock file next to each module. Most of these
# modules have no external dependency, so their locks record only
# locally built images and are not worth committing.
lask.lock.json

# 09-dependencies is the exception: its lock is the pin, and a pin that
# is not committed pins nothing.
!09-dependencies/lask.lock.json

# Scratch space the files-and-paths example writes into.
tmp/
