// Example 03: driving Terraform through the external lask-terraform module.
//
// The dependency is declared in lask.json, pinned by content
// hash (spec ch. 5). Fetch it once (the only network-touching step):
//   lask deps sync
// Then, from this directory:
//   lask run  deploy --version 1.2.3
//   lask eval drifted --version 1.2.3
//   lask run  teardown
//
// Commands run with this example's directory as cwd; the Terraform root
// module lives in ./infra and uses only the builtin terraform_data resource,
// so apply touches nothing outside this directory. By default commands run in
// Docker (#docker("alpine/terragrunt:1.5.7")), so host terraform is optional.
// For OpenTofu, pass both --bin tofu and an --env image that includes tofu.

import * as tf from "terraform"

// Applies the desired version and returns the deployed_version output.
deploy(
  --version: String = "1.0.0"
  ): String = do {
  tf.init(dir = "infra" )
  tf.apply(dir = "infra",  vars = {app_version: version})
  as_string(tf.output_value("deployed_version", dir = "infra"))
}

// True when the infrastructure differs from the desired version.
plan(
  --version: String = "1.0.0"
): Bool = do {
  tf.init(dir = "infra")
  p = tf.plan(dir = "infra", vars = {app_version: version})
  p.changed
}

destroy(
  --version: String = "1.0.0"
): String = do {
  tf.destroy(dir = "infra",  vars = {app_version: version}, auto_approve = true)
  "destroyed"
}

as_string(v: Any): String = cast(v)
